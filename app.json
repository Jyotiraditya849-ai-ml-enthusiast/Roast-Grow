{
  "expo": {
    "name": "Roast & Grow",
    "slug": "streak-tracker-app",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.streaktracker.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.streaktracker.app"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to attach proof photos to your daily habit journal entries.",
        "NSPhotoLibraryUsageDescription": "This app requires access to your photo library to attach photos to your daily habit journal entries."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.streaktracker.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Roast & Grow to access your photos for journal attachments.",
          "cameraPermission": "Allow Roast & Grow to take photos for your streak proof."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f97316"
        }
      ],
      "./plugins/withAndroidWidget"
    ],
    "extra": {
      "eas": {
        "projectId": "b4216d26-b2e0-49e5-88d1-d23442cd2643"
      }
    }
  }
}