<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#0D1117"
    android:padding="10dp">

    <!-- Left Column: Streak Counter & Status -->
    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#161B22"
        android:padding="6dp">

        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 ACTIVE"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#F97316" />

        <TextView
            android:id="@+id/widget_streak_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#F97316" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAY STREAK"
            android:textSize="8sp"
            android:textColor="#8B949E"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Column: Goals Status, Incomplete Habits & AI Motivation -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <!-- Challenge Title -->
        <TextView
            android:id="@+id/widget_challenge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100 DAYS OF CODE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:singleLine="true" />

        <!-- Row 1: Supreme Goal Status (Done / Incomplete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_supreme_goal_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Supreme Goal: Incomplete ⏳"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#EF4444"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Row 2: Incomplete Habits Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_habits_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Habits: 0/4 (4 Incomplete)"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#EAB308"
                android:singleLine="true" />
        </LinearLayout>

        <!-- AI Motivation / Quote -->
        <TextView
            android:id="@+id/widget_ai_motivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="&quot;Lock in today's supreme mission and micro-habits!&quot;"
            android:textSize="10sp"
            android:textColor="#C9D1D9"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
